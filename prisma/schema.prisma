generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  email       String    @unique
  password    String
  phoneNumber String?
  image       String?
  role        String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("users")
}

// Backs the Role dropdown on the Users create/edit form. `User.role` stays a
// plain string (matching the value stored here and the keys ROLE_PERMISSIONS
// in lib/permissions.ts already expects) rather than a foreign key, since no
// Roles/Permissions CRUD exists yet to manage this table's rows themselves.
model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Warehouse {
  id          String    @id @default(cuid())
  name        String
  email       String
  phoneNumber String
  country     String
  city        String
  zipCode     String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stocks ProductStock[]

  @@map("warehouses")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(120)
  email     String   @unique @db.VarChar(190)
  phone     String   @db.VarChar(32)
  country   String   @db.VarChar(80)
  city      String   @db.VarChar(80)
  address   String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks ProductStock[]

  @@index([name])
  @@index([createdAt])
  @@map("suppliers")
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  logo      String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]

  @@index([name])
  @@index([createdAt])
  @@map("brands")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  logo      String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]

  @@index([name])
  @@index([createdAt])
  @@map("categories")
}

// Backs the Product Unit dropdown on the Products create/edit form, the
// same way Role backs the Role dropdown on Users — Product.productUnit
// stores the unit's `name` as a plain string (not a foreign key) since
// there's no Units CRUD to manage this table's rows yet either.
model Unit {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("units")
}

enum TaxType {
  EXCLUSIVE
  INCLUSIVE
}

enum StockStatus {
  RECEIVED
  PENDING
  ORDERED
}

model Product {
  id                 String    @id @default(cuid())
  name               String
  code               String    @unique
  price              Decimal   @db.Decimal(12, 2)
  categoryId         String
  category           Category  @relation(fields: [categoryId], references: [id])
  brandId            String
  brand              Brand     @relation(fields: [brandId], references: [id])
  // Plain string (matching the Unit table's `name`), not a foreign key —
  // see the Unit model's comment above.
  productUnit        String
  stockAlert         Int?
  orderTax           Decimal?  @db.Decimal(5, 2)
  taxType            TaxType
  quantityLimitation Int?
  notes              String?   @db.Text
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  images ProductImage[]
  stocks ProductStock[]

  @@index([name])
  @@index([code])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String
  // The list thumbnail and the first image shown on the View page are
  // whichever row sorts first by (sortOrder, createdAt) — not a separate
  // "isPrimary" flag, so reordering is just an update to this column.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

// One row per (product, warehouse) — a current-quantity snapshot, not a
// transaction ledger. Created once at product-create time from the "Add
// Stock" form; see app/(dashboard)/products/actions.ts for why edit
// deliberately never re-runs that insert (it would inflate quantity on
// every save). Real stock movements belong to the separate Adjustments
// module, not this table's create/update path.
model ProductStock {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
  // Nullable + SetNull (unlike the required field on the create form) so a
  // supplier hard-deleted later (Suppliers has no soft-delete or "in use"
  // guard today) can't leave this row's FK dangling or block that delete.
  supplierId  String?
  supplier    Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  quantity    Int         @default(0)
  status      StockStatus @default(RECEIVED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("product_stocks")
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  email       String
  phoneNumber String
  dateOfBirth DateTime?
  country     String
  city        String
  address     String
  // Marks the single protected "direct-customer" walk-in record the POS
  // falls back to when no specific customer is selected. Used instead of
  // matching on name/email (which are editable and not guaranteed unique)
  // so the delete action and the list UI can reliably identify the record
  // to protect regardless of what it's been renamed to.
  isDefault   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
  @@index([createdAt])
  @@map("customers")
}
