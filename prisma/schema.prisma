generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  email       String    @unique
  password    String
  phoneNumber String?
  image       String?
  role        String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("users")
}

// Backs the Role dropdown on the Users create/edit form. `User.role` stays a
// plain string (matching the value stored here and the keys ROLE_PERMISSIONS
// in lib/permissions.ts already expects) rather than a foreign key, since no
// Roles/Permissions CRUD exists yet to manage this table's rows themselves.
model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Warehouse {
  id          String    @id @default(cuid())
  name        String
  email       String
  phoneNumber String
  country     String
  city        String
  zipCode     String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stocks          ProductStock[]
  adjustments     Adjustment[]
  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]
  sales           Sale[]
  saleReturns     SaleReturn[]
  transfersFrom   Transfer[]       @relation("TransferFrom")
  transfersTo     Transfer[]       @relation("TransferTo")

  @@map("warehouses")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(120)
  email     String   @unique @db.VarChar(190)
  phone     String   @db.VarChar(32)
  country   String   @db.VarChar(80)
  city      String   @db.VarChar(80)
  address   String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks          ProductStock[]
  purchases       Purchase[]
  purchaseReturns PurchaseReturn[]

  @@index([name])
  @@index([createdAt])
  @@map("suppliers")
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  logo      String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]

  @@index([name])
  @@index([createdAt])
  @@map("brands")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  logo      String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products Product[]

  @@index([name])
  @@index([createdAt])
  @@map("categories")
}

// Backs the Product Unit dropdown on the Products create/edit form, the
// same way Role backs the Role dropdown on Users — Product.productUnit
// stores the unit's `name` as a plain string (not a foreign key) since
// there's no Units CRUD to manage this table's rows yet either.
model Unit {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("units")
}

enum TaxType {
  EXCLUSIVE
  INCLUSIVE
}

enum StockStatus {
  RECEIVED
  PENDING
  ORDERED
}

model Product {
  id                 String    @id @default(cuid())
  name               String
  code               String    @unique
  price              Decimal   @db.Decimal(12, 2)
  categoryId         String
  category           Category  @relation(fields: [categoryId], references: [id])
  brandId            String
  brand              Brand     @relation(fields: [brandId], references: [id])
  // Plain string (matching the Unit table's `name`), not a foreign key —
  // see the Unit model's comment above.
  productUnit        String
  stockAlert         Int?
  orderTax           Decimal?  @db.Decimal(5, 2)
  taxType            TaxType
  quantityLimitation Int?
  notes              String?   @db.Text
  deletedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  images              ProductImage[]
  stocks              ProductStock[]
  adjustmentItems     AdjustmentItem[]
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]
  transferItems       TransferItem[]

  @@index([name])
  @@index([code])
  @@index([createdAt])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  path      String
  // The list thumbnail and the first image shown on the View page are
  // whichever row sorts first by (sortOrder, createdAt) — not a separate
  // "isPrimary" flag, so reordering is just an update to this column.
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
  @@map("product_images")
}

// One row per (product, warehouse) — a current-quantity snapshot, not a
// transaction ledger. Created once at product-create time from the "Add
// Stock" form; see app/(dashboard)/products/actions.ts for why edit
// deliberately never re-runs that insert (it would inflate quantity on
// every save). Real stock movements belong to the separate Adjustments
// module, not this table's create/update path.
model ProductStock {
  id          String      @id @default(cuid())
  productId   String
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
  // Nullable + SetNull (unlike the required field on the create form) so a
  // supplier hard-deleted later (Suppliers has no soft-delete or "in use"
  // guard today) can't leave this row's FK dangling or block that delete.
  supplierId  String?
  supplier    Supplier?   @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  quantity    Int         @default(0)
  status      StockStatus @default(RECEIVED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@map("product_stocks")
}

enum AdjustmentItemType {
  ADDITION
  SUBTRACTION
}

// A multi-item document — the header a manual stock change is filed under.
// Nothing else has an `adjustmentId` foreign key, so unlike Brand/Category/
// Product there's no "is this in use" delete guard to write for it: soft-
// deleting an Adjustment only hides it from the list. It deliberately does
// NOT reverse the ProductStock changes it made (see
// app/(dashboard)/adjustments/actions.ts) — an adjustment is a record of a
// stock change that happened, not a draft that can be undone by deleting
// the paper trail.
model Adjustment {
  id          String    @id @default(cuid())
  reference   String    @unique
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  date        DateTime
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  items AdjustmentItem[]

  @@index([warehouseId])
  @@index([createdAt])
  @@map("adjustments")
}

model AdjustmentItem {
  id           String             @id @default(cuid())
  adjustmentId String
  adjustment   Adjustment         @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  productId    String
  product      Product            @relation(fields: [productId], references: [id])
  quantity     Int
  type         AdjustmentItemType

  @@index([adjustmentId])
  @@index([productId])
  @@map("adjustment_items")
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  email       String
  phoneNumber String
  dateOfBirth DateTime?
  country     String
  city        String
  address     String
  // Marks the single protected "direct-customer" walk-in record the POS
  // falls back to when no specific customer is selected. Used instead of
  // matching on name/email (which are editable and not guaranteed unique)
  // so the delete action and the list UI can reliably identify the record
  // to protect regardless of what it's been renamed to.
  isDefault   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  sales       Sale[]
  saleReturns SaleReturn[]

  @@index([name])
  @@index([createdAt])
  @@map("customers")
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum PurchasePaymentStatus {
  UNPAID
  PAID
  PARTIAL
}

// A purchase increases stock (the opposite of a Sale, which will decrease
// it) — see lib/stock.ts, the shared service every stock mutation in this
// app goes through. `status` reuses the existing StockStatus enum (already
// RECEIVED/PENDING/ORDERED on ProductStock) rather than a duplicate
// Purchase-only enum with the same three values. Stock is only ever added
// for a Purchase whose status is RECEIVED — see the create/edit actions.
//
// paymentType/paymentStatus exist so the list and future reports can show
// them (design/Purchases.html's "Payment Type" column, design/Purchase
// Reports.html's Paid/Due columns), but design/Create Purchase.html has no
// input for either — paymentType stays null and paymentStatus stays UNPAID
// until a future Payments feature sets them; this module never writes them.
model Purchase {
  id            String                @id @default(cuid())
  reference     String                @unique
  supplierId    String
  supplier      Supplier              @relation(fields: [supplierId], references: [id])
  warehouseId   String
  warehouse     Warehouse             @relation(fields: [warehouseId], references: [id])
  date          DateTime
  status        StockStatus           @default(RECEIVED)
  orderTax      Decimal               @default(0) @db.Decimal(5, 2)
  discount      Decimal               @default(0) @db.Decimal(12, 2)
  shipping      Decimal               @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal               @db.Decimal(12, 2)
  paymentType   String?
  paymentStatus PurchasePaymentStatus @default(UNPAID)
  notes         String?               @db.Text
  deletedAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  items   PurchaseItem[]
  // Back-relation for PurchaseReturn.purchaseId — see that model's comment.
  returns PurchaseReturn[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([createdAt])
  @@index([date])
  @@map("purchases")
}

model PurchaseItem {
  id           String       @id @default(cuid())
  purchaseId   String
  purchase     Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId    String
  product      Product      @relation(fields: [productId], references: [id])
  netUnitCost  Decimal      @db.Decimal(12, 2)
  quantity     Int
  discountType DiscountType @default(FIXED)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  taxType      TaxType      @default(EXCLUSIVE)
  orderTax     Decimal      @default(0) @db.Decimal(5, 2)
  // Not in the original field list but needed to persist the per-line edit
  // modal's "Purchase Unit" select (design/Create Purchase.html) — without
  // it, that choice would be lost on save and the View/Edit pages couldn't
  // show what was actually purchased. Defaults to the product's own unit.
  unit         String
  subtotal     Decimal      @db.Decimal(12, 2)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

// The mirror image of Purchase (see its comment above): a purchase return
// DECREMENTS warehouse stock instead of adding it — lib/stock.ts's
// adjustProductStock is called with a negative delta here instead of
// Purchase's positive one, and its own negative-stock guard is what stops a
// return from taking a warehouse below zero. `status` reuses the same
// StockStatus enum for the same reason Purchase does, and stock only moves
// once a return is RECEIVED (see the create/edit/delete actions).
// `purchaseId` is an optional link back to the original Purchase this is
// returning against — design/Create Purchase Return.html has no picker for
// one yet, so this module's own form always leaves it unset; it's here for
// a future "return against this purchase" entry point to fill in.
// paid/due/paymentType mirror Purchase's own unwritten paymentType (see its
// comment) — design/Purchases Returns.html's list shows Paid/Due columns,
// but nothing in this module writes them yet pending a future Payments
// feature.
model PurchaseReturn {
  id          String      @id @default(cuid())
  reference   String      @unique
  supplierId  String
  supplier    Supplier    @relation(fields: [supplierId], references: [id])
  warehouseId String
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id])
  purchaseId  String?
  purchase    Purchase?   @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  date        DateTime
  status      StockStatus @default(RECEIVED)
  orderTax    Decimal     @default(0) @db.Decimal(5, 2)
  discount    Decimal     @default(0) @db.Decimal(12, 2)
  shipping    Decimal     @default(0) @db.Decimal(12, 2)
  grandTotal  Decimal     @db.Decimal(12, 2)
  paid        Decimal     @default(0) @db.Decimal(12, 2)
  due         Decimal     @default(0) @db.Decimal(12, 2)
  paymentType String?
  notes       String?     @db.Text
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items PurchaseReturnItem[]

  @@index([supplierId])
  @@index([warehouseId])
  @@index([purchaseId])
  @@index([createdAt])
  @@index([date])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id             String         @id @default(cuid())
  returnId       String
  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  netUnitCost    Decimal        @db.Decimal(12, 2)
  quantity       Int
  discountType   DiscountType   @default(FIXED)
  discount       Decimal        @default(0) @db.Decimal(12, 2)
  taxType        TaxType        @default(EXCLUSIVE)
  orderTax       Decimal        @default(0) @db.Decimal(5, 2)
  // Same reasoning as PurchaseItem.unit above — persists the per-line edit
  // modal's "Purchase Unit" choice (this module reuses that modal as-is).
  unit           String
  subtotal       Decimal        @db.Decimal(12, 2)

  @@index([returnId])
  @@index([productId])
  @@map("purchase_return_items")
}

enum SalePaymentStatus {
  UNPAID
  PAID
  PARTIAL
}

// A sale DECREMENTS stock — same direction as PurchaseReturn, opposite of
// Purchase — via lib/stock.ts, only once `status` is RECEIVED (same
// StockStatus reuse and same rule as Purchase/PurchaseReturn). Unlike
// those two, `paymentStatus` here is NOT a dormant unwritten field: Sales
// actually tracks payments (see SalePayment below), and paymentStatus is
// always DERIVED from sum(payments) vs grandTotal — paid >= grandTotal ->
// PAID, paid == 0 -> UNPAID, otherwise -> PARTIAL. It's never set directly
// from a free-typed value, even though design/Create Sale.html draws it as
// a plain <select> (the live form renders it read-only/computed instead —
// see SaleForm's own comment). `paid`/`due` are kept as denormalized
// columns on Sale (recomputed from the SalePayment sum on every payment
// change) purely so the list/detail pages can display them without an
// aggregate query per row.
model Sale {
  id            String            @id @default(cuid())
  reference     String            @unique
  customerId    String
  customer      Customer          @relation(fields: [customerId], references: [id])
  warehouseId   String
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  date          DateTime
  status        StockStatus       @default(RECEIVED)
  orderTax      Decimal           @default(0) @db.Decimal(5, 2)
  discount      Decimal           @default(0) @db.Decimal(12, 2)
  shipping      Decimal           @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal           @db.Decimal(12, 2)
  paid          Decimal           @default(0) @db.Decimal(12, 2)
  due           Decimal           @default(0) @db.Decimal(12, 2)
  paymentStatus SalePaymentStatus @default(UNPAID)
  // The most recent payment's method, shown as the list's "Payment Type"
  // chip (design/Sales.html) — null until the first SalePayment is
  // recorded. Not a dropdown on the create form itself; see SaleForm.
  paymentType   String?
  notes         String?           @db.Text
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  items    SaleItem[]
  payments SalePayment[]
  // Back-relation for SaleReturn.saleId — see that model's comment.
  returns  SaleReturn[]

  @@index([customerId])
  @@index([warehouseId])
  @@index([createdAt])
  @@index([date])
  @@map("sales")
}

model SaleItem {
  id           String       @id @default(cuid())
  saleId       String
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product      @relation(fields: [productId], references: [id])
  // A sale's line price starts from the product's own selling `price`
  // (Product.price), not its cost — the equivalent field on PurchaseItem
  // (netUnitCost) starts from what the supplier charges instead.
  netUnitPrice Decimal      @db.Decimal(12, 2)
  quantity     Int
  discountType DiscountType @default(FIXED)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  taxType      TaxType      @default(EXCLUSIVE)
  orderTax     Decimal      @default(0) @db.Decimal(5, 2)
  // Same reasoning as PurchaseItem.unit — persists the per-line edit
  // modal's "Sale Unit" choice.
  unit         String
  subtotal     Decimal      @db.Decimal(12, 2)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

// An append-only payment ledger — unlike Purchase/PurchaseReturn's single
// unwritten paymentType column, a Sale can be paid down over multiple
// visits (see the "Show Payments" flow), so each payment is its own row
// rather than a single mutable amount on Sale itself. Sale.paid/due/
// paymentStatus are recomputed from the sum of these rows every time one
// is added — never edited or deleted through this module, matching the
// scope of the "add a payment" flow this schema is built for.
model SalePayment {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2)
  paymentType String
  date        DateTime
  notes       String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([saleId])
  @@map("sale_payments")
}

// A return's own workflow state — how far it's been processed
// (Pending -> Received -> Completed), matching design/Edit Sale
// Return.html's own dropdown exactly. Deliberately its OWN enum, not a
// reuse of StockStatus (Purchase/Sale's Received/Pending/Ordered): unlike
// every other module in this family, stock movement here is NOT gated by
// status at all — see the SaleReturn model's own comment — so this never
// needed to share StockStatus's vocabulary or default.
enum SaleReturnStatus {
  PENDING
  RECEIVED
  COMPLETED
}

// Mirrors Sale (see its comment) with the stock direction reversed, per the
// task's own framing: a Sale removes stock, so a SaleReturn ADDS it back —
// the same direction Purchase uses — via lib/stock.ts's
// adjustProductStock, called with a POSITIVE delta here. Unlike
// Purchase/PurchaseReturn/Sale, that stock movement is NOT conditioned on
// `status`: a return record is created after the physical return already
// happened, so the goods go back into inventory unconditionally on save
// (see the create/edit actions) — `status` (SaleReturnStatus above) only
// tracks the return's own processing workflow, independent of stock.
// `saleId` links back to the original Sale this return is against —
// nullable + SetNull so deleting that Sale later can't leave this FK
// dangling or be blocked by it.
// paid/due/paymentStatus represent the REFUND owed to the customer (the
// opposite direction of Sale's own paid/due, which represents money
// collected FROM the customer) — they default to Unpaid/$0 on create and
// stay that way until a future refund-recording feature (out of scope
// here) changes them; reuses Sale's own SalePaymentStatus enum since the
// three states mean the same thing for a refund as for a payment.
model SaleReturn {
  id            String            @id @default(cuid())
  reference     String            @unique
  customerId    String
  customer      Customer          @relation(fields: [customerId], references: [id])
  warehouseId   String
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id])
  saleId        String?
  sale          Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  date          DateTime
  status        SaleReturnStatus  @default(PENDING)
  orderTax      Decimal           @default(0) @db.Decimal(5, 2)
  discount      Decimal           @default(0) @db.Decimal(12, 2)
  shipping      Decimal           @default(0) @db.Decimal(12, 2)
  grandTotal    Decimal           @db.Decimal(12, 2)
  paid          Decimal           @default(0) @db.Decimal(12, 2)
  due           Decimal           @default(0) @db.Decimal(12, 2)
  paymentStatus SalePaymentStatus @default(UNPAID)
  notes         String?           @db.Text
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  items SaleReturnItem[]

  @@index([customerId])
  @@index([warehouseId])
  @@index([saleId])
  @@index([createdAt])
  @@index([date])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String       @id @default(cuid())
  returnId     String
  saleReturn   SaleReturn   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  productId    String
  product      Product      @relation(fields: [productId], references: [id])
  netUnitPrice Decimal      @db.Decimal(12, 2)
  quantity     Int
  discountType DiscountType @default(FIXED)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  taxType      TaxType      @default(EXCLUSIVE)
  orderTax     Decimal      @default(0) @db.Decimal(5, 2)
  // Same reasoning as SaleItem.unit — persists the per-line edit modal's
  // "Sale Unit" choice (this module reuses SaleItemModal as-is, same
  // wording).
  unit         String
  subtotal     Decimal      @db.Decimal(12, 2)

  @@index([returnId])
  @@index([productId])
  @@map("sale_return_items")
}

enum TransferStatus {
  PENDING
  SENT
  COMPLETED
}

// The only module that touches two warehouses in a single document — see
// AGENTS.md. Every stock movement here calls lib/stock.ts's
// adjustProductStock TWICE per line, inside one prisma.$transaction: an
// equal decrement on fromWarehouseId and increment on toWarehouseId, so the
// pair can never apply partially and total system stock never changes (see
// the create/edit/delete actions for exactly when that pair runs relative
// to `status`). No supplier/customer/payment fields — a transfer moves
// stock between this app's own warehouses, it isn't a transaction with an
// outside party.
model Transfer {
  id              String         @id @default(cuid())
  reference       String         @unique
  fromWarehouseId String
  fromWarehouse   Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id])
  date            DateTime
  status          TransferStatus @default(PENDING)
  orderTax        Decimal        @default(0) @db.Decimal(5, 2)
  discount        Decimal        @default(0) @db.Decimal(12, 2)
  shipping        Decimal        @default(0) @db.Decimal(12, 2)
  grandTotal      Decimal        @db.Decimal(12, 2)
  notes           String?        @db.Text
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items TransferItem[]

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([createdAt])
  @@index([date])
  @@map("transfers")
}

model TransferItem {
  id           String       @id @default(cuid())
  transferId   String
  transfer     Transfer     @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId    String
  product      Product      @relation(fields: [productId], references: [id])
  netUnitCost  Decimal      @db.Decimal(12, 2)
  quantity     Int
  discountType DiscountType @default(FIXED)
  discount     Decimal      @default(0) @db.Decimal(12, 2)
  taxType      TaxType      @default(EXCLUSIVE)
  orderTax     Decimal      @default(0) @db.Decimal(5, 2)
  // Not in the original field list but needed to persist the per-line edit
  // modal's "Product Unit" select (design/Create Transfer.html reuses the
  // same modal shape as Purchase/Sale) — same reasoning as PurchaseItem.unit.
  // Defaults to the product's own unit.
  unit         String
  subtotal     Decimal      @db.Decimal(12, 2)

  @@index([transferId])
  @@index([productId])
  @@map("transfer_items")
}
