generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  email       String    @unique
  password    String
  phoneNumber String?
  image       String?
  role        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  roleId      String
  roleRef     Role      @relation(fields: [roleId], references: [id], onDelete: NoAction)

  @@index([roleId])
  @@map("users")
}

model Role {
  id          String    @id @default(cuid())
  name        String    @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  permissions String    @db.LongText
  deletedAt   DateTime?
  users       User[]

  @@map("roles")
}

model Warehouse {
  id              String           @id @default(cuid())
  name            String
  email           String
  phoneNumber     String
  country         String
  city            String
  zipCode         String
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  adjustments     Adjustment[]
  expenses        Expense[]
  stocks          ProductStock[]
  purchaseReturns PurchaseReturn[]
  purchases       Purchase[]
  saleReturns     SaleReturn[]
  sales           Sale[]
  transfersFrom   Transfer[]       @relation("TransferFrom")
  transfersTo     Transfer[]       @relation("TransferTo")

  @@map("warehouses")
}

model Supplier {
  id              String           @id @default(cuid())
  name            String           @db.VarChar(120)
  email           String           @unique @db.VarChar(190)
  phone           String           @db.VarChar(32)
  country         String           @db.VarChar(80)
  city            String           @db.VarChar(80)
  address         String           @db.VarChar(255)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  stocks          ProductStock[]
  purchaseReturns PurchaseReturn[]
  purchases       Purchase[]

  @@index([name])
  @@index([createdAt])
  @@map("suppliers")
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  logo      String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([name])
  @@index([createdAt])
  @@map("brands")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  logo      String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@index([name])
  @@index([createdAt])
  @@map("categories")
}

model ExpenseCategory {
  id        String    @id @default(cuid())
  name      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expenses  Expense[]

  @@index([name])
  @@index([createdAt])
  @@map("expense_categories")
}

model Expense {
  id                String          @id @default(cuid())
  reference         String          @unique
  date              DateTime
  title             String
  warehouseId       String
  expenseCategoryId String
  amount            Decimal         @db.Decimal(12, 2)
  details           String?         @db.Text
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  category          ExpenseCategory @relation(fields: [expenseCategoryId], references: [id], onDelete: NoAction)
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: NoAction)

  @@index([warehouseId])
  @@index([expenseCategoryId])
  @@index([createdAt])
  @@map("expenses")
}

model Unit {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("units")
}

model Product {
  id                  String               @id @default(cuid())
  name                String
  code                String               @unique
  price               Decimal              @db.Decimal(12, 2)
  categoryId          String
  brandId             String
  productUnit         String
  stockAlert          Int?
  orderTax            Decimal?             @db.Decimal(5, 2)
  taxType             TaxType
  quantityLimitation  Int?
  notes               String?              @db.Text
  deletedAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  adjustmentItems     AdjustmentItem[]
  images              ProductImage[]
  stocks              ProductStock[]
  brand               Brand                @relation(fields: [brandId], references: [id], onDelete: NoAction)
  category            Category             @relation(fields: [categoryId], references: [id], onDelete: NoAction)
  purchaseItems       PurchaseItem[]
  purchaseReturnItems PurchaseReturnItem[]
  saleItems           SaleItem[]
  saleReturnItems     SaleReturnItem[]
  transferItems       TransferItem[]

  @@index([name])
  @@index([code])
  @@index([createdAt])
  @@index([brandId], map: "products_brandId_fkey")
  @@index([categoryId], map: "products_categoryId_fkey")
  @@map("products")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  path      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model ProductStock {
  id          String      @id @default(cuid())
  productId   String
  warehouseId String
  supplierId  String?
  quantity    Int         @default(0)
  status      StockStatus @default(RECEIVED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier    Supplier?   @relation(fields: [supplierId], references: [id])
  warehouse   Warehouse   @relation(fields: [warehouseId], references: [id], onDelete: NoAction)

  @@unique([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
  @@index([supplierId], map: "product_stocks_supplierId_fkey")
  @@map("product_stocks")
}

model Adjustment {
  id          String           @id @default(cuid())
  reference   String           @unique
  warehouseId String
  date        DateTime
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       AdjustmentItem[]
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: NoAction)

  @@index([warehouseId])
  @@index([createdAt])
  @@map("adjustments")
}

model AdjustmentItem {
  id           String             @id @default(cuid())
  adjustmentId String
  productId    String
  quantity     Int
  type         AdjustmentItemType
  adjustment   Adjustment         @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product      Product            @relation(fields: [productId], references: [id], onDelete: NoAction)

  @@index([adjustmentId])
  @@index([productId])
  @@map("adjustment_items")
}

model Customer {
  id          String       @id @default(cuid())
  name        String
  email       String
  phoneNumber String
  dateOfBirth DateTime?
  country     String
  city        String
  address     String
  isDefault   Boolean      @default(false)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  saleReturns SaleReturn[]
  sales       Sale[]

  @@index([name])
  @@index([createdAt])
  @@map("customers")
}

model Purchase {
  id            String                @id @default(cuid())
  reference     String                @unique
  supplierId    String
  warehouseId   String
  date          DateTime
  status        StockStatus           @default(RECEIVED)
  orderTax      Decimal               @default(0.00) @db.Decimal(5, 2)
  discount      Decimal               @default(0.00) @db.Decimal(12, 2)
  shipping      Decimal               @default(0.00) @db.Decimal(12, 2)
  grandTotal    Decimal               @db.Decimal(12, 2)
  paymentType   String?
  paymentStatus PurchasePaymentStatus @default(UNPAID)
  notes         String?               @db.Text
  deletedAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  items         PurchaseItem[]
  returns       PurchaseReturn[]
  supplier      Supplier              @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  warehouse     Warehouse             @relation(fields: [warehouseId], references: [id], onDelete: NoAction)

  @@index([supplierId])
  @@index([warehouseId])
  @@index([createdAt])
  @@index([date])
  @@map("purchases")
}

model PurchaseItem {
  id           String       @id @default(cuid())
  purchaseId   String
  productId    String
  netUnitCost  Decimal      @db.Decimal(12, 2)
  quantity     Int
  discountType DiscountType @default(FIXED)
  discount     Decimal      @default(0.00) @db.Decimal(12, 2)
  taxType      TaxType      @default(EXCLUSIVE)
  orderTax     Decimal      @default(0.00) @db.Decimal(5, 2)
  unit         String
  subtotal     Decimal      @db.Decimal(12, 2)
  product      Product      @relation(fields: [productId], references: [id], onDelete: NoAction)
  purchase     Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model PurchaseReturn {
  id          String               @id @default(cuid())
  reference   String               @unique
  supplierId  String
  warehouseId String
  purchaseId  String?
  date        DateTime
  status      StockStatus          @default(RECEIVED)
  orderTax    Decimal              @default(0.00) @db.Decimal(5, 2)
  discount    Decimal              @default(0.00) @db.Decimal(12, 2)
  shipping    Decimal              @default(0.00) @db.Decimal(12, 2)
  grandTotal  Decimal              @db.Decimal(12, 2)
  paid        Decimal              @default(0.00) @db.Decimal(12, 2)
  due         Decimal              @default(0.00) @db.Decimal(12, 2)
  paymentType String?
  notes       String?              @db.Text
  deletedAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  items       PurchaseReturnItem[]
  purchase    Purchase?            @relation(fields: [purchaseId], references: [id])
  supplier    Supplier             @relation(fields: [supplierId], references: [id], onDelete: NoAction)
  warehouse   Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: NoAction)

  @@index([supplierId])
  @@index([warehouseId])
  @@index([purchaseId])
  @@index([createdAt])
  @@index([date])
  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id             String         @id @default(cuid())
  returnId       String
  productId      String
  netUnitCost    Decimal        @db.Decimal(12, 2)
  quantity       Int
  discountType   DiscountType   @default(FIXED)
  discount       Decimal        @default(0.00) @db.Decimal(12, 2)
  taxType        TaxType        @default(EXCLUSIVE)
  orderTax       Decimal        @default(0.00) @db.Decimal(5, 2)
  unit           String
  subtotal       Decimal        @db.Decimal(12, 2)
  product        Product        @relation(fields: [productId], references: [id], onDelete: NoAction)
  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([productId])
  @@map("purchase_return_items")
}

model Sale {
  id            String            @id @default(cuid())
  reference     String            @unique
  customerId    String
  warehouseId   String
  date          DateTime
  status        StockStatus       @default(RECEIVED)
  orderTax      Decimal           @default(0.00) @db.Decimal(5, 2)
  discount      Decimal           @default(0.00) @db.Decimal(12, 2)
  shipping      Decimal           @default(0.00) @db.Decimal(12, 2)
  grandTotal    Decimal           @db.Decimal(12, 2)
  paid          Decimal           @default(0.00) @db.Decimal(12, 2)
  due           Decimal           @default(0.00) @db.Decimal(12, 2)
  paymentStatus SalePaymentStatus @default(UNPAID)
  paymentType   String?
  notes         String?           @db.Text
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  items         SaleItem[]
  payments      SalePayment[]
  returns       SaleReturn[]
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: NoAction)
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: NoAction)

  @@index([customerId])
  @@index([warehouseId])
  @@index([createdAt])
  @@index([date])
  @@map("sales")
}

model SaleItem {
  id           String       @id @default(cuid())
  saleId       String
  productId    String
  netUnitPrice Decimal      @db.Decimal(12, 2)
  quantity     Int
  discountType DiscountType @default(FIXED)
  discount     Decimal      @default(0.00) @db.Decimal(12, 2)
  taxType      TaxType      @default(EXCLUSIVE)
  orderTax     Decimal      @default(0.00) @db.Decimal(5, 2)
  unit         String
  subtotal     Decimal      @db.Decimal(12, 2)
  product      Product      @relation(fields: [productId], references: [id], onDelete: NoAction)
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model SalePayment {
  id          String   @id @default(cuid())
  saleId      String
  amount      Decimal  @db.Decimal(12, 2)
  paymentType String
  date        DateTime
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@map("sale_payments")
}

model SaleReturn {
  id            String            @id @default(cuid())
  reference     String            @unique
  customerId    String
  warehouseId   String
  saleId        String?
  date          DateTime
  status        SaleReturnStatus  @default(PENDING)
  orderTax      Decimal           @default(0.00) @db.Decimal(5, 2)
  discount      Decimal           @default(0.00) @db.Decimal(12, 2)
  shipping      Decimal           @default(0.00) @db.Decimal(12, 2)
  grandTotal    Decimal           @db.Decimal(12, 2)
  paid          Decimal           @default(0.00) @db.Decimal(12, 2)
  due           Decimal           @default(0.00) @db.Decimal(12, 2)
  paymentStatus SalePaymentStatus @default(UNPAID)
  notes         String?           @db.Text
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  items         SaleReturnItem[]
  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: NoAction)
  sale          Sale?             @relation(fields: [saleId], references: [id])
  warehouse     Warehouse         @relation(fields: [warehouseId], references: [id], onDelete: NoAction)

  @@index([customerId])
  @@index([warehouseId])
  @@index([saleId])
  @@index([createdAt])
  @@index([date])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String       @id @default(cuid())
  returnId     String
  productId    String
  netUnitPrice Decimal      @db.Decimal(12, 2)
  quantity     Int
  discountType DiscountType @default(FIXED)
  discount     Decimal      @default(0.00) @db.Decimal(12, 2)
  taxType      TaxType      @default(EXCLUSIVE)
  orderTax     Decimal      @default(0.00) @db.Decimal(5, 2)
  unit         String
  subtotal     Decimal      @db.Decimal(12, 2)
  product      Product      @relation(fields: [productId], references: [id], onDelete: NoAction)
  saleReturn   SaleReturn   @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([productId])
  @@map("sale_return_items")
}

model Transfer {
  id              String         @id @default(cuid())
  reference       String         @unique
  fromWarehouseId String
  toWarehouseId   String
  date            DateTime
  status          TransferStatus @default(PENDING)
  orderTax        Decimal        @default(0.00) @db.Decimal(5, 2)
  discount        Decimal        @default(0.00) @db.Decimal(12, 2)
  shipping        Decimal        @default(0.00) @db.Decimal(12, 2)
  grandTotal      Decimal        @db.Decimal(12, 2)
  notes           String?        @db.Text
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           TransferItem[]
  fromWarehouse   Warehouse      @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: NoAction)
  toWarehouse     Warehouse      @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: NoAction)

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([createdAt])
  @@index([date])
  @@map("transfers")
}

model TransferItem {
  id           String       @id @default(cuid())
  transferId   String
  productId    String
  netUnitCost  Decimal      @db.Decimal(12, 2)
  quantity     Int
  discountType DiscountType @default(FIXED)
  discount     Decimal      @default(0.00) @db.Decimal(12, 2)
  taxType      TaxType      @default(EXCLUSIVE)
  orderTax     Decimal      @default(0.00) @db.Decimal(5, 2)
  unit         String
  subtotal     Decimal      @db.Decimal(12, 2)
  product      Product      @relation(fields: [productId], references: [id], onDelete: NoAction)
  transfer     Transfer     @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([productId])
  @@map("transfer_items")
}

enum TaxType {
  EXCLUSIVE
  INCLUSIVE
}

enum StockStatus {
  RECEIVED
  PENDING
  ORDERED
}

enum AdjustmentItemType {
  ADDITION
  SUBTRACTION
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum PurchasePaymentStatus {
  UNPAID
  PAID
  PARTIAL
}

enum SalePaymentStatus {
  UNPAID
  PAID
  PARTIAL
}

enum SaleReturnStatus {
  PENDING
  RECEIVED
  COMPLETED
}

enum TransferStatus {
  PENDING
  SENT
  COMPLETED
}
