generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String   @unique
  password    String
  phoneNumber String?
  image       String?
  role        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}

model Warehouse {
  id          String    @id @default(cuid())
  name        String
  email       String
  phoneNumber String
  country     String
  city        String
  zipCode     String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("warehouses")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(120)
  email     String   @unique @db.VarChar(190)
  phone     String   @db.VarChar(32)
  country   String   @db.VarChar(80)
  city      String   @db.VarChar(80)
  address   String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([createdAt])
  @@map("suppliers")
}
