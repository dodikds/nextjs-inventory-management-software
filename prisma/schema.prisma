generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(cuid())
  firstName   String
  lastName    String
  email       String    @unique
  password    String
  phoneNumber String?
  image       String?
  role        String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("users")
}

// Backs the Role dropdown on the Users create/edit form. `User.role` stays a
// plain string (matching the value stored here and the keys ROLE_PERMISSIONS
// in lib/permissions.ts already expects) rather than a foreign key, since no
// Roles/Permissions CRUD exists yet to manage this table's rows themselves.
model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("roles")
}

model Warehouse {
  id          String    @id @default(cuid())
  name        String
  email       String
  phoneNumber String
  country     String
  city        String
  zipCode     String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("warehouses")
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(120)
  email     String   @unique @db.VarChar(190)
  phone     String   @db.VarChar(32)
  country   String   @db.VarChar(80)
  city      String   @db.VarChar(80)
  address   String   @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([createdAt])
  @@map("suppliers")
}

model Brand {
  id        String    @id @default(cuid())
  name      String
  logo      String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
  @@index([createdAt])
  @@map("brands")
}

model Category {
  id        String    @id @default(cuid())
  name      String
  logo      String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([name])
  @@index([createdAt])
  @@map("categories")
}

model Customer {
  id          String    @id @default(cuid())
  name        String
  email       String
  phoneNumber String
  dateOfBirth DateTime?
  country     String
  city        String
  address     String
  // Marks the single protected "direct-customer" walk-in record the POS
  // falls back to when no specific customer is selected. Used instead of
  // matching on name/email (which are editable and not guaranteed unique)
  // so the delete action and the list UI can reliably identify the record
  // to protect regardless of what it's been renamed to.
  isDefault   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([name])
  @@index([createdAt])
  @@map("customers")
}
